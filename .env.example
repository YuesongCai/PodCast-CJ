# 复制成 .env 后填入你自己的值。.env 已在 .gitignore 里，不会进仓库。
#
# 为什么必须走环境变量：这个仓库是公开的。飞书群机器人 webhook URL 一旦泄漏，
# 任何人都能往你的群里发消息；Base token 泄漏则等于公开表格的读写入口。

# 飞书群机器人 webhook（群设置 -> 添加机器人 -> 自定义机器人）
LARK_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 私聊推送的接收人 open_id（用 lark-cli contact 查；留空则跳过私聊）
LARK_USER_ID=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 多维表格。首次用 `python3 pipeline/sync_bitable.py --init` 会自动新建并写回
# data/bitable.json，之后把 token 填到这里即可。
LARK_BASE_TOKEN=
LARK_BASE_TABLE=每日判断
LARK_DOMAIN=https://your-tenant.feishu.cn

# lark-cli 路径（一般不用改）
LARK_CLI=/opt/homebrew/bin/lark-cli
