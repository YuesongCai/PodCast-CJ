# 复制成 .env 后填入你自己的值。.env 已在 .gitignore 里，不会进仓库。
#
# 为什么必须走环境变量：这个仓库是公开的。SMTP 密码、Telegram bot token、
# 飞书 webhook URL 任何一个泄漏，别人就能以你的名义发东西。

# ============================================================
# 渠道：至少配一个。没配的渠道会自动跳过，不算失败。
# ============================================================

# ---------- ① 邮件（主渠道：每天早上一封） ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# 587 = STARTTLS（大多数情况），465 = SSL
SMTP_USER=you@gmail.com
# 注意：Gmail / Outlook / 企业邮箱基本都不接受登录密码，
# 要在账号安全设置里单独生成「应用专用密码 / App Password」。
SMTP_PASS=
EMAIL_FROM=播客早报 <you@gmail.com>
# 多个收件人用逗号分隔
EMAIL_TO=cj@example.com,aaron@example.com

# ---------- ② Telegram ----------
# bot token 找 @BotFather 要；chat_id 找 @userinfobot 要（群聊 id 是负数）。
# 注意 bot 必须先被你私聊过一次（或拉进群），否则发不出去。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- ③ 飞书 ----------
# 群机器人 webhook（群设置 -> 添加机器人 -> 自定义机器人）
LARK_WEBHOOK=
# 私聊推送的接收人 open_id（用 lark-cli contact 查；留空则跳过私聊）
LARK_USER_ID=
# lark-cli 路径（一般不用改）
LARK_CLI=/opt/homebrew/bin/lark-cli

# ============================================================
# 判断环节（LLM）
# ============================================================
# 后端二选一，judge.py 默认 auto：有 ANTHROPIC_API_KEY 走 API，否则走本机
# claude CLI（复用 Claude Code 订阅授权，不需要额外的 key）。
ANTHROPIC_API_KEY=
# 判断质量就是这个产品的全部价值，所以默认用最强的模型。
# 想省钱改 claude-sonnet-5：一次约 64K input tokens。
PODCAST_JUDGE_MODEL=claude-opus-5

# ============================================================
# 存档（可选）
# ============================================================
# 多维表格。首次用 `python3 pipeline/sync_bitable.py --init` 会自动新建并
# 写回 data/bitable.json，之后把 token 填到这里即可。
LARK_BASE_TOKEN=
LARK_BASE_TABLE=每日判断
LARK_DOMAIN=https://your-tenant.feishu.cn
